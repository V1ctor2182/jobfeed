[Unit]
Description=Jobfeed application email sync (reads Gmail subjects and snippets, sends nothing)

[Service]
Type=oneshot
WorkingDirectory=%h/jobfeed/resume-application-pipeline
Environment=PATH=%h/jobfeed/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/jobfeed/resume-application-pipeline/.venv/bin/python -m pipeline.mail_tracker sync
TimeoutStartSec=15min
